DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bizdata_db?schema=public"
JWT_SECRET="CHANGE-ME-IN-PRODUCTION-USE-OPENSSL-RAND"
PORT=4200
FRONTEND_URL="http://localhost:4201"
NODE_ENV=development
TENANT_NAME="BizData Tenant"

# PII field-level encryption (AES-256-GCM) + blind-index keys — base64-encoded 32 bytes each
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENC_KEY=""          # active encryption key (id "1")
PII_INDEX_KEY=""        # blind-index key (stable — not rotated; rotating it invalidates all indexes)
# Key rotation (90-day policy): provision the next key as PII_ENC_KEY_2 (then _3, …),
# point PII_ENC_ACTIVE_KEY_ID at it, restart, then POST /governance/key-reencrypt to
# migrate existing data. Old keys must remain set so historical ciphertext still decrypts.
# PII_ENC_KEY_2=""
# PII_ENC_KEY_2_CREATED="2026-07-01"   # optional: provisioning date for the rotation clock
# PII_ENC_ACTIVE_KEY_ID="2"
#
# Envelope encryption (HSM/KMS) — keys never stored in the clear. Set
# PII_KMS_PROVIDER to switch from env keys to wrapped DEKs unwrapped at boot via
# the KMS/HSM. See common/services/kms.ts (implement the vendor adapter) and the
# runbook §3. Leave unset to use PII_ENC_KEY above.
# PII_KMS_PROVIDER="aws"               # aws | gcp | azure | pkcs11 | local
# PII_WRAPPED_DEK=""                   # base64 wrapped DEK, id "1" (add _2, _3… to rotate)
# PII_KMS_LOCAL_KEK=""                 # only for PII_KMS_PROVIDER=local (dev/CI): base64 32-byte KEK

# Background scheduler (daily §41(6) deadline sweep + agent refresh, weekly scan). Set to "false" to disable.
SCHEDULER_ENABLED="true"

# TLS 1.3 / mutual-TLS (optional — if unset, serves HTTP and TLS terminates at the gateway)
# TLS_CERT_PATH="/path/server.crt"
# TLS_KEY_PATH="/path/server.key"
# TLS_CA_PATH="/path/ca.crt"          # for mTLS client-cert verification (bank ingestion)
# TLS_REQUEST_CLIENT_CERT="true"      # require + verify client certs (mTLS)
# BVN_CHECKDIGIT_ENFORCED="false"     # enable modulo-11 BVN check once CBN algorithm confirmed

# Transactional email (SMTP) — powers self-service "forgot password" links.
# If SMTP_HOST is unset, email sending is DISABLED: the forgot-password flow
# still works but no mail is delivered (the reset link is logged in dev). Point
# these at the government SMTP relay and ensure SPF/DKIM/DMARC on the domain.
# SMTP_HOST="smtp.kirs.gov.ng"
# SMTP_PORT="587"                     # 587 = STARTTLS (default), 465 = implicit TLS
# SMTP_SECURE="false"                 # "true" only for port 465 implicit TLS
# SMTP_USER=""                        # leave blank for an unauthenticated relay
# SMTP_PASS=""
# SMTP_FROM="BizData <no-reply@kirs.gov.ng>"
