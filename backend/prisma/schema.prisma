// BizData — Multi-Source Data Intelligence Platform
// Schema for v1: bank reports first, generic enough for fintechs, telcos, payment processors, FX bureaus, POS, e-commerce.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUPERVISOR
  ANALYST
  AUDIT_OFFICER
  DPO
  READONLY
}

enum ProviderType {
  BANK
  FINTECH
  PAYMENT_PROCESSOR
  TELCO
  FX_BUREAU
  POS_AGGREGATOR
  ECOMMERCE
  INSURANCE
  OTHER
}

enum ProviderStatus {
  ACTIVE
  SUSPENDED
  PENDING_ONBOARDING
}

enum ProviderUserRole {
  PROVIDER_ADMIN
  COMPLIANCE_OFFICER
  DATA_OPERATOR
}

enum TaxpayerType {
  INDIVIDUAL
  CORPORATE
  GOVERNMENT
}

enum TaxpayerStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
  DECEASED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SubmissionStatus {
  RECEIVED
  VALIDATING
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
}

enum ReportReviewStatus {
  PENDING_REVIEW
  CLEARED
  CONFIRMED
}

enum ScanStatus {
  RUNNING
  COMPLETED
  FAILED
}

// ─── TENANT ───────────────────────────────────────────────────────────────────

model Tenant {
  id          String   @id @default(uuid())
  name        String
  shortName   String
  contactEmail String?
  contactPhone String?
  address     String?
  logoUrl     String?
  themeColor  String?  @default("#0f766e")
  scanThreshold Decimal @default(0.20) @db.Decimal(5, 4)
  retentionYears Int    @default(6) // NDPA §28 storage limitation (Nigeria tax 6-yr standard)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tenants")
}

// ─── STAFF USERS ──────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  // DB CHECK constraint `users_passwordHash_not_blank` (migration
  // 20260719090000) enforces char_length >= 60 so an empty/blank hash can never
  // be persisted (which silently locks the account out of login).
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  avatarUrl      String?   // passport photo, stored as a base64 data URL
  role           UserRole  @default(READONLY)
  isActive       Boolean   @default(true)
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String?
  mfaRecoveryCodes String[] @default([]) // bcrypt hashes of one-time backup codes
  lastLoginAt    DateTime?
  // Set on every password change (self-service or admin reset). A staff JWT
  // carries a `pwdIat` claim; the guard rejects any token issued before this
  // instant, so changing the password evicts all existing sessions.
  passwordChangedAt DateTime?
  // Set true when an admin resets the password. The account can authenticate
  // but is forced to set a new password before doing anything else; cleared on
  // the next self-service change.
  mustChangePassword Boolean  @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  reviewedReports DataRecord[]           @relation("ReviewedReports")
  scansRun        UnderdeclarationScan[] @relation("ScanRunBy")
  auditEvents     AuditLog[]             @relation("AuditUser")
  assignedCases   UnderdeclarationCase[] @relation("CaseAssignee")
  elevations      AccessElevation[]      @relation("ElevationStaff")
  elevationsDecided AccessElevation[]    @relation("ElevationDecider")
  portfolios      AnalystPortfolio[]     @relation("PortfolioOwner")

  @@map("users")
}

// ─── ANALYST PORTFOLIOS ───────────────────────────────────────────────────────
// A staff member owns a "book of work" — a set of providers, provider types, or
// sectors. New cases auto-route to the owner of the most specific match
// (individual provider > provider type > sector). One row per assignment.

enum PortfolioScope {
  PROVIDER       // owns one specific provider
  PROVIDER_TYPE  // owns all providers of a type (e.g. all INSURANCE)
  SECTOR         // owns an economic sector (e.g. TRADING)
}

model AnalystPortfolio {
  id         String         @id @default(uuid())
  staffId    String
  scope      PortfolioScope
  // The target of the ownership, keyed by scope:
  //   PROVIDER      → providerId
  //   PROVIDER_TYPE → the ProviderType value (e.g. "INSURANCE")
  //   SECTOR        → the sector string (e.g. "TRADING")
  targetValue String
  createdAt  DateTime       @default(now())

  staff User @relation("PortfolioOwner", fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([scope, targetValue]) // one owner per provider/type/sector
  @@index([staffId])
  @@map("analyst_portfolios")
}

// ─── DATA PROVIDERS (banks, fintechs, telcos, etc.) ───────────────────────────

model DataProvider {
  id           String         @id @default(uuid())
  providerCode String         @unique // CBN code, telco code, fintech code, etc.
  name         String
  providerType ProviderType
  contactEmail String?
  contactPhone String?
  address      String?
  status       ProviderStatus @default(PENDING_ONBOARDING)
  // QUARTERLY | MONTHLY | ANNUAL. NTAA 2025 §29 (Official Gazette No. 117, 26 Jun
  // 2025) prescribes ANNUAL returns for financial institutions. We DELIBERATELY
  // default to QUARTERLY — a stricter-than-statutory cadence that gives finer
  // enforcement granularity — not an oversight. The §29 thresholds (₦50m
  // individual / ₦250m corporate, monthly-cumulative) ARE matched. Set a provider
  // to ANNUAL to align it strictly with §29.
  reportingFrequency String?  @default("QUARTERLY")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  users        DataProviderUser[]
  submissions  DataSubmission[]
  records      DataRecord[]
  mou          BankMou?
  uploads      SubmissionUpload[]
  penalties    ProviderPenalty[]

  @@map("data_providers")
}

// ─── PROVIDER LATE/FAILURE-TO-FILE PENALTIES (NTAA 2025 s.101) ─────────────────
// A formal, auditable penalty record raised against a provider for a reporting
// period it filed late or failed to file. The amount is computed on the s.101
// basis (first-month fine + per-subsequent-month fine) using the StatutoryConfig
// figures active when the penalty is issued; the version + breakdown are stamped
// for defensibility. One record per provider/period (re-issuing refreshes it).
model ProviderPenalty {
  id            String   @id @default(uuid())
  providerId    String
  periodLabel   String   // e.g. '2025-Q2' or '2025-03'
  periodYear    Int
  dueAt         DateTime // statutory due date for the period
  reason        String   // 'LATE' | 'MISSING'
  monthsInDefault Int    // whole months counted (>=1)
  firstMonthAmount Decimal @db.Decimal(18, 2)
  perMonthAmount   Decimal @db.Decimal(18, 2)
  amount        Decimal  @db.Decimal(18, 2) // total: first + (monthsInDefault-1) * perMonth
  basis         Json?    // methodology snapshot (statute, figures, dates) for the notice
  statutoryVersion Int?  // StatutoryConfig.version used
  status        String   @default("ASSESSED") // 'ASSESSED' | 'NOTIFIED' | 'WAIVED' | 'PAID'
  noticeRef     String?  // e.g. PPN-2025-Q2-AB12CD
  notifiedAt    DateTime?
  resolvedAt    DateTime?
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  provider      DataProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, periodLabel])
  @@index([providerId])
  @@index([status])
  @@map("provider_penalties")
}

model DataProviderUser {
  id           String           @id @default(uuid())
  providerId   String
  email        String           @unique
  // DB CHECK constraint `data_provider_users_passwordHash_not_blank` (migration
  // 20260719090000) enforces char_length >= 60 — a blank hash can never persist.
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?          // passport photo, stored as a base64 data URL
  role         ProviderUserRole @default(COMPLIANCE_OFFICER)
  isActive     Boolean          @default(true)
  lastLoginAt  DateTime?
  // Mirrors the staff User fields: a provider JWT carries a `pwdIat` claim and
  // the guard rejects tokens issued before this instant, so a password change
  // (self-service, admin reset, or forgot-password) evicts existing sessions.
  passwordChangedAt DateTime?
  // Set when the password was reset (admin or forgot-password); forces the user
  // to set a new password before using the portal. Cleared on next self-change.
  mustChangePassword Boolean    @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  provider     DataProvider     @relation(fields: [providerId], references: [id])
  submissions  DataSubmission[] @relation("SubmittedByProviderUser")

  @@map("data_provider_users")
}

// ─── PASSWORD RESET TOKENS ────────────────────────────────────────────────────
// Single-use, expiring tokens for self-service "forgot password". Only the
// SHA-256 hash of the token is stored (mirrors IntegrationApiKey); the raw
// token travels only in the emailed reset link. Covers both account types.
enum ResetUserType {
  STAFF
  PROVIDER
}

model PasswordResetToken {
  id         String        @id @default(uuid())
  tokenHash  String        @unique // SHA-256 of the raw token; raw only in the email link
  userType   ResetUserType
  userId     String                // User.id or DataProviderUser.id, per userType
  expiresAt  DateTime
  usedAt     DateTime?             // set once consumed; a used token cannot be reused
  createdAt  DateTime      @default(now())

  @@index([userType, userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ─── TAXPAYERS ────────────────────────────────────────────────────────────────

model Taxpayer {
  id             String         @id @default(uuid())
  // PII identifiers are encrypted at rest (AES-256-GCM). A keyed HMAC "blind
  // index" backs uniqueness + equality lookup without storing the plaintext.
  ninEnc         String?
  ninIndex       String?        @unique
  bvnEnc         String?
  bvnIndex       String?        @unique
  tinEnc         String?
  tinIndex       String?        @unique
  cacRcNumber    String?        @unique
  type           TaxpayerType
  status         TaxpayerStatus @default(ACTIVE)
  firstName      String?
  lastName       String?
  middleName     String?
  businessName   String?
  phone          String?
  email          String?
  address        String?
  stateOfResidence String?
  dateOfBirth    DateTime?      // used by TIN-BVN probabilistic matching (Agent 2)
  sector         String?        // economic sector — provider-supplied or Sector Classification (Agent 3)
  businessType   String?        // nature of business (e.g. "Retail", "Restaurant", "Consultancy") — provider-supplied
  identityVerifiedAt DateTime?  // set when NIN was confirmed via an external source (NIBSS/NIMC)
  identitySource String?        // 'NIBSS' | 'NIMC' | 'MOCK' — how the NIN was verified
  // ── Legal form: limited-liability company (LTD/Limited/PLC) ──
  // CIT/VAT are FEDERAL taxes — a State IRS does NOT assess income tax on limited
  // companies. Defaulted from the business-name suffix at ingest/scan; staff may
  // override (a genuine Ltd whose stored name omits the suffix, or vice-versa).
  // When true, the scan raises no income-underdeclaration case; the party is
  // pursued on the PAYE/CGT/WHT remittance-verification track (see Tax Net).
  isLimitedLiability Boolean   @default(false)
  llcSource      String?        // 'NAME_SUFFIX' | 'MANUAL' — how isLimitedLiability was set
  // ── PAYE / employer registration (mainly for CORPORATE taxpayers) ──
  // BIZDATA cannot know PAYE status natively; it is pushed from the KIRS Tax app
  // (POST /integration/paye) or set manually by staff. A corporate that is
  // observed earning but is not REGISTERED is a PAYE-gap lead (see Tax Net).
  payeStatus     String?        @default("UNKNOWN") // 'REGISTERED' | 'NOT_REGISTERED' | 'UNKNOWN'
  payeRegNumber  String?        // employer/PAYE registration number from the Tax app
  payeVerifiedAt DateTime?      // when the PAYE status was last confirmed
  payeSource     String?        // 'TAX_APP_SYNC' | 'MANUAL'
  riskScore      Int            @default(100)
  riskLevel      RiskLevel      @default(LOW)
  riskComputedAt DateTime?
  riskFlags      Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  records         DataRecord[]
  declaredIncomes DeclaredIncome[]
  cases           UnderdeclarationCase[]
  riskSignals     RiskSignal[]
  crossStateReferrals CrossStateReferral[]
  taxPayments     TaxPayment[]

  @@map("taxpayers")
}

model DeclaredIncome {
  id               String   @id @default(uuid())
  taxpayerId       String
  year             Int
  assessableIncome Decimal  @db.Decimal(18, 2)
  source           String?  // 'DIRECT_ASSESSMENT', 'PAYE', 'MANUAL_IMPORT', 'API_SYNC'
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  taxpayer         Taxpayer @relation(fields: [taxpayerId], references: [id])

  @@unique([taxpayerId, year])
  @@map("declared_incomes")
}

/// Tax actually PAID by a taxpayer, by type (PAYE, WHT, CGT, CIT, VAT, …).
/// BIZDATA does not know this natively — it is pushed from the KIRS Tax app
/// (POST /integration/tax-payments) or entered by staff. Powers the per-type
/// "tax cards" in the AI tax report (paid vs assessed vs observed).
model TaxPayment {
  id          String   @id @default(uuid())
  taxpayerId  String
  taxType     String   // 'PAYE' | 'WHT' | 'CGT' | 'CIT' | 'VAT' | 'OTHER'
  year        Int
  period      String?  // optional finer period, e.g. '2026-Q2' or '2026-03'
  amountPaid  Decimal  @db.Decimal(18, 2)
  reference   String?  // payment/receipt reference from the Tax app
  source      String?  // 'TAX_APP_SYNC' | 'MANUAL'
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  taxpayer    Taxpayer @relation(fields: [taxpayerId], references: [id])

  @@index([taxpayerId, year])
  @@index([taxpayerId, taxType, year])
  @@map("tax_payments")
}

// ─── SUBMISSIONS ─────────────────────────────────────────────────────────────

/// A tax-authority admin's one-time grant allowing a provider to (re)submit for a
/// specific quarter that is otherwise locked (one-submission-per-period rule).
/// Consumed when the provider next submits for that period.
model ResubmitPermission {
  id          String   @id @default(uuid())
  providerId  String
  periodLabel String   // the quarter unlocked, e.g. "2026-Q2"
  reason      String?
  grantedById String   // staff (SUPER_ADMIN/ADMIN) who granted it
  consumed    Boolean  @default(false)
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([providerId, periodLabel, consumed])
  @@map("resubmit_permissions")
}

// Need-to-know access grant: a staff officer (SUPER_ADMIN/ADMIN only) may view or
// download raw taxpayer records for a SPECIFIC provider OR a SPECIFIC case. Even
// SUPER_ADMIN is constrained — they must self-assign (with a reason), which is
// audited. Exactly one of providerId / caseId is set. An assignment is active
// while revokedAt IS NULL. Access is re-checked on every record fetch, so a
// revoke cuts access immediately (mid-session), regardless of the step-up token.
model AccessAssignment {
  id          String    @id @default(uuid())
  staffId     String    // the officer granted access
  providerId  String?   // provider-level grant (governs Provider Uploads records/export)
  caseId      String?   // case-level grant (governs case-detail raw PII)
  reason      String    // why this access was granted (required — incl. self-assign)
  grantedById String    // SUPER_ADMIN/ADMIN who granted it (== staffId when self-assigned)
  selfAssigned Boolean  @default(false)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime? // set when access is withdrawn; NULL = active
  revokedById String?

  @@index([staffId, providerId, revokedAt])
  @@index([staffId, caseId, revokedAt])
  @@map("access_assignments")
}

// Four-eyes grant token for unlocking raw records. An assigned officer REQUESTS
// access; a SUPER_ADMIN (never the requester) APPROVES, which mints a one-time
// token (raw shown to the approver + emailed to the officer; only the SHA-256
// hash is stored). The officer redeems it with their PASSWORD + the token to
// unlock. Once redeemed it is reusable for that provider/case for the work
// session window (redeemedAt + sessionHours), then expires. Fully audited.
enum GrantTokenStatus {
  PENDING   // requested, awaiting approval
  APPROVED  // approved, token minted, redeemable
  REDEEMED  // officer has redeemed at least once (session active)
  REVOKED   // withdrawn by an admin
  EXPIRED   // past its window
}

model AccessGrantToken {
  id           String           @id @default(uuid())
  staffId      String           // the officer who will unlock (requester)
  providerId   String?          // provider-scoped grant
  caseId       String?          // case-scoped grant
  reason       String           // business justification (required, audited)
  status       GrantTokenStatus @default(PENDING)
  tokenHash    String?          // SHA-256 of the raw token; set on approval, cleared on revoke/expire
  requestedAt  DateTime         @default(now())
  approvedById String?          // SUPER_ADMIN who approved (must differ from staffId)
  approvedAt   DateTime?
  redeemExpiresAt DateTime?      // deadline for the FIRST redemption after approval
  redeemedAt   DateTime?         // first successful redemption; starts the session window
  sessionExpiresAt DateTime?     // redeemedAt + sessionHours; token usable until then
  revokedAt    DateTime?
  revokedById  String?

  @@index([staffId, status])
  @@index([tokenHash])
  @@map("access_grant_tokens")
}

model DataSubmission {
  id              String           @id @default(uuid())
  providerId      String
  submittedByUserId String?
  submittedByStaffId String?       // when staff uploads on behalf of provider
  periodLabel     String           // e.g. "2026-Q1", "2026-03", "2026"
  periodYear      Int
  periodQuarter   Int?
  periodMonth     Int?
  fileName        String?
  fileSizeBytes   Int?
  recordCount     Int              @default(0)
  acceptedCount   Int              @default(0)
  rejectedCount   Int              @default(0)
  warningCount    Int              @default(0)   // rows accepted but carrying a grace-period warning
  validationErrors Json?
  warnings        Json?                          // per-row grace-period warnings (accepted rows)
  status          SubmissionStatus @default(RECEIVED)
  receiptHash     String?          // §6.5 acknowledgment receipt issued on receipt
  resubmitDueAt   DateTime?        // §6.5 deadline to resubmit a rejected/partial file (5 business days)
  receivedAt      DateTime         @default(now())
  processedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  provider         DataProvider      @relation(fields: [providerId], references: [id])
  submittedByUser  DataProviderUser? @relation("SubmittedByProviderUser", fields: [submittedByUserId], references: [id])
  records          DataRecord[]

  @@map("data_submissions")
}

// ─── LARGE-FILE SPLIT UPLOAD (§6.4 500 MB split/batching protocol) ────────────
// A provider splits a large export into ordered parts. Each part is uploaded
// against a shared session; on completion the parts are reassembled (in order),
// the full-file SHA-256 is verified, and the reassembled CSV is streamed through
// the normal ingestion pipeline. Parts are deleted after a successful complete.

model SubmissionUpload {
  id                String   @id @default(uuid())
  providerId        String
  periodLabel       String
  periodYear        Int?
  periodQuarter     Int?
  periodMonth       Int?
  fileName          String
  totalParts        Int
  expectedChecksum  String?  // SHA-256 of the whole reassembled file (§6.4)
  totalBytes        Int      @default(0)
  status            String   @default("OPEN") // OPEN | COMPLETED | ABORTED
  submissionId      String?  // the DataSubmission produced on completion
  submittedByStaffId String?
  submittedByUserId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  provider DataProvider           @relation(fields: [providerId], references: [id])
  parts    SubmissionUploadPart[]

  @@index([providerId])
  @@map("submission_uploads")
}

model SubmissionUploadPart {
  id         String   @id @default(uuid())
  uploadId   String
  partNumber Int      // 1-based
  sizeBytes  Int
  checksum   String?  // optional SHA-256 of this part
  data       Bytes    // raw part payload
  createdAt  DateTime @default(now())

  upload SubmissionUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@unique([uploadId, partNumber])
  @@index([uploadId])
  @@map("submission_upload_parts")
}

// ─── DATA RECORDS (generic — bank reports, fintech tx, telco usage, etc.) ────

model DataRecord {
  id                      String              @id @default(uuid())
  submissionId            String
  providerId              String
  providerType            ProviderType
  taxpayerId              String?

  // Common identifiers (subset present depending on provider type)
  accountNumber           String?
  bvn                     String?
  nin                     String?
  phoneNumber             String?
  walletId                String?
  merchantId              String?

  accountName             String?
  periodLabel             String
  periodYear              Int

  // Entity resolution quality (how this row was linked to a taxpayer)
  matchMethod             String?             // 'NIN' | 'TIN' | 'BVN' | 'NAME' | 'UNMATCHED'
  matchConfidence         Decimal?            @db.Decimal(3, 2) // 0..1
  accountIndex            String?             // HMAC blind index of accountNumber (duplicate detection)

  // Common monetary fields
  totalInflow             Decimal?            @db.Decimal(18, 2)
  totalOutflow            Decimal?            @db.Decimal(18, 2)
  openingBalance          Decimal?            @db.Decimal(18, 2)
  closingBalance          Decimal?            @db.Decimal(18, 2)
  transactionCount        Int?

  // Provider-specific payload (FX bureau exchange volumes, telco airtime, etc.)
  payload                 Json?

  // Underdeclaration scan results
  flaggedAsUnderdeclared  Boolean             @default(false)
  declaredIncome          Decimal?            @db.Decimal(18, 2)
  discrepancyAmount       Decimal?            @db.Decimal(18, 2)
  discrepancyPct          Decimal?            @db.Decimal(8, 4)
  flaggedAt               DateTime?

  // Review workflow
  reviewStatus            ReportReviewStatus? @default(PENDING_REVIEW)
  reviewedById            String?
  reviewedAt              DateTime?
  reviewNotes             String?

  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  submission DataSubmission @relation(fields: [submissionId], references: [id])
  provider   DataProvider   @relation(fields: [providerId], references: [id])
  taxpayer   Taxpayer?      @relation(fields: [taxpayerId], references: [id])
  reviewedBy User?          @relation("ReviewedReports", fields: [reviewedById], references: [id])

  @@index([taxpayerId, periodYear])
  @@index([providerId, periodLabel])
  @@index([providerId, periodLabel, accountIndex])
  @@index([flaggedAsUnderdeclared, reviewStatus])
  @@map("data_records")
}

// ─── UNDERDECLARATION SCAN ───────────────────────────────────────────────────

model UnderdeclarationScan {
  id              String     @id @default(uuid())
  year            Int
  threshold       Decimal    @db.Decimal(5, 4) // e.g. 0.20 = 20%
  providerTypes   Json?      // array of ProviderType to include, null = all
  totalScanned    Int        @default(0)
  totalFlagged    Int        @default(0)
  totalRecovered  Decimal?   @db.Decimal(18, 2)
  totalEstimatedTax Decimal? @db.Decimal(18, 2) // sum of recoverable tax across flagged cases
  engineVersion   String?                       // detection methodology version used
  status          ScanStatus @default(RUNNING)
  errorMessage    String?
  startedById     String
  startedAt       DateTime   @default(now())
  completedAt     DateTime?
  createdAt       DateTime   @default(now())

  startedBy User @relation("ScanRunBy", fields: [startedById], references: [id])
  cases     UnderdeclarationCase[]

  @@map("underdeclaration_scans")
}

// ─── UNDERDECLARATION CASE (one per taxpayer-year — the unit of work) ────────
// Produced by the detection engine, surfaced on the dashboard, and progressed
// through the §29 enforcement lifecycle (notice → objection → recovery).

enum CaseStatus {
  OPEN           // freshly detected, awaiting triage
  UNDER_REVIEW   // officer reviewing
  NOTICE_ISSUED  // assessment / information notice served
  OBJECTION      // taxpayer objected — within statutory window
  CONFIRMED      // assessment upheld
  SETTLED        // payment plan / agreed
  RECOVERED      // revenue collected
  DISMISSED      // false positive / cleared
  CLOSED         // archived
}

model UnderdeclarationCase {
  id                String     @id @default(uuid())
  taxpayerId        String
  year              Int
  scanId            String?
  observedIncome    Decimal    @db.Decimal(18, 2) // normalized income proxy
  declaredIncome    Decimal    @db.Decimal(18, 2)
  discrepancyAmount Decimal    @db.Decimal(18, 2)
  discrepancyPct    Decimal    @db.Decimal(8, 4)
  estimatedTaxDue   Decimal    @db.Decimal(18, 2) // recoverable tax estimate on the gap (graduated NTA bands)
  taxBasis          String?    // 'PIT_GRADUATED' | 'NOT_ASSESSED_LLC' — how estimatedTaxDue was derived
  altTaxRate        Decimal?   @db.Decimal(5, 4)  // configurable flat comparison rate (seeded from CIT)
  altTaxDue         Decimal?   @db.Decimal(18, 2) // the gap taxed at altTaxRate, shown beside the graduated figure
  confidence        Decimal    @db.Decimal(3, 2)  // 0..1 detection-engine confidence
  agentScore        Decimal?   @db.Decimal(3, 2)  // 0..1 aggregate AI-agent corroboration
  reasons           Json?      // reason codes explaining the flag
  providerCount     Int        @default(0)        // corroborating distinct providers
  engineVersion     String?
  status            CaseStatus @default(OPEN)
  riskLevel         RiskLevel  @default(MEDIUM)
  assignedToId      String?
  recoveredAmount   Decimal?   @db.Decimal(18, 2)

  // §35 Best-of-Judgement assessment (computed when a notice is issued)
  assessedTax       Decimal?   @db.Decimal(18, 2) // additional tax on the discrepancy
  penaltyAmount     Decimal?   @db.Decimal(18, 2) // 10% late-payment penalty
  assessedTotal     Decimal?   @db.Decimal(18, 2) // tax + penalty (the demand)
  assessmentBasis   Json?      // breakdown / methodology snapshot for defensibility
  demandNoticeRef   String?    // e.g. DN-2025-AB12CD
  caseAccessToken   String?    @unique // scoped token for the taxpayer-integration API, issued at notice time

  noticeIssuedAt    DateTime?
  objectionDueAt    DateTime?  // §41: 30 days for the taxpayer to object
  authorityResponseDueAt DateTime? // §41(6): 90 days for the authority to respond, else deemed upheld
  resolvedAt        DateTime?
  statutoryVersion  Int?       // StatutoryConfig.version used when the assessment was raised
  objectionGrounds  String?    @db.Text // taxpayer's written objection, filed via the integration API
  objectionFiledAt  DateTime?
  notes             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  taxpayer   Taxpayer              @relation(fields: [taxpayerId], references: [id])
  scan       UnderdeclarationScan? @relation(fields: [scanId], references: [id])
  assignedTo User?                 @relation("CaseAssignee", fields: [assignedToId], references: [id])
  documents  CaseDocument[]

  @@unique([taxpayerId, year])
  @@index([status])
  @@index([riskLevel])
  @@map("underdeclaration_cases")
}

// ─── OBJECTION DOCUMENTS ──────────────────────────────────────────────────────
// A taxpayer's supporting documents uploaded at objection time. The file text is
// extracted (OCR for scans/PDFs, direct read for text/CSV), the Document
// Intelligence agent reconciles the declared figures against observed inflow,
// and the verdict is stored here + raised as a RiskSignal.

model CaseDocument {
  id            String   @id @default(uuid())
  caseId        String
  fileName      String
  mimeType      String?
  fileSizeBytes Int?
  extractedText String?  @db.Text // OCR/parsed text the reconciliation ran on
  extractionSource String? // 'TEXT' | 'OCR' | 'PASTED'
  // Reconciliation result (Document Intelligence)
  declaredIncome Decimal? @db.Decimal(18, 2)
  variance      Decimal? @db.Decimal(8, 4) // (declared - observed) / observed
  consistent    Boolean?
  reconcileNote String?  @db.Text
  // Capital-gains (NTA §50) — extracted asset-disposal proceeds + assessed CGT
  assetDisposals Decimal? @db.Decimal(18, 2)
  cgtAssessed    Decimal? @db.Decimal(18, 2)
  uploadedById  String?
  createdAt     DateTime @default(now())

  case UnderdeclarationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("case_documents")
}

// ─── STATUTORY CONFIGURATION (versioned) ──────────────────────────────────────
// The legal parameters that drive assessments — due-date windows, objection and
// authority-response windows, penalty and tax rates, and the CIT threshold.
// Editing creates a NEW version (the old one is retained); exactly one row is
// active at a time. Every assessment stamps the version it used, so a case can
// always be re-explained against the law as it stood when it was raised.

model StatutoryConfig {
  id                    String   @id @default(uuid())
  version               Int      @unique
  isActive              Boolean  @default(false)

  // §29 / §6.6 — provider reporting obligation
  reportingDueDays      Int      @default(15)   // days after period end a return is due

  // §41 — objection lifecycle
  objectionWindowDays   Int      @default(30)   // taxpayer's window to object
  authorityResponseDays Int      @default(90)   // §41(6) — else deemed upheld

  // Penalty + tax rates
  latePaymentPenaltyRate Decimal @default(0.10) @db.Decimal(5, 4) // 10%
  citRate               Decimal  @default(0.30) @db.Decimal(5, 4) // 30% company income tax
  citSmallCoThreshold   Decimal  @default(50000000) @db.Decimal(18, 2) // small-company exemption ceiling
  cgtRate               Decimal  @default(0.10) @db.Decimal(5, 4) // 10% capital-gains tax (NTA §50)

  // Detection default
  defaultScanThreshold  Decimal  @default(0.20) @db.Decimal(5, 4) // discrepancy % to flag
  // Statutory REPORTING thresholds: a taxpayer is only reportable (appears in any
  // report/case/flag/scan/tax-net) once its cumulative inflow within a reporting
  // period (quarter) reaches these amounts. Below-threshold parties are hidden.
  reportingThresholdIndividual Decimal @default(50000000)  @db.Decimal(18, 2) // 50m per period, individuals
  reportingThresholdCorporate  Decimal @default(250000000) @db.Decimal(18, 2) // 250m per period, corporates

  // Provider late/failure-to-file penalty (NTAA 2025 s.101). A provider that
  // files a statutory return late, or misses it entirely, incurs a fixed fine
  // for the first month of default plus a further fixed fine for each subsequent
  // month it continues. Both amounts are editable so the authority can track the
  // gazetted figures over time. Seeded from s.101 (₦100k first / ₦50k each after).
  providerPenaltyFirstMonth Decimal @default(100000) @db.Decimal(18, 2)
  providerPenaltyPerMonth   Decimal @default(50000)  @db.Decimal(18, 2)
  // Days a provider is given to settle a penalty demand, counted from the notice
  // date. Printed on the formal demand letter as the payment deadline.
  providerPenaltyPaymentDays Int @default(30)
  // Commencement date for provider penalties. A period is penalised only if its
  // statutory due date falls on/after this date — so nothing accrues before the
  // authority formally begins enforcement. Null → enforce from every due date.
  providerPenaltyEffectiveFrom DateTime?

  // Grace period for phased-in compulsory submission fields (sector /
  // businessType / customerType). Blank values warn before this date and are
  // rejected on/after it. Null → fall back to the schema's built-in enforceFrom.
  fieldEnforcementDate  DateTime?

  note                  String?  // why this version was created
  createdById           String?
  createdAt             DateTime @default(now())

  @@index([isActive])
  @@map("statutory_configs")
}

// ─── TAXPAYER INTEGRATION API ─────────────────────────────────────────────────
// BIZDATA is the assessment engine; the taxpayer interacts through their own
// existing platform, which calls this API machine-to-machine. Two credentials:
//   1. IntegrationApiKey — authenticates the partner platform (hashed at rest).
//   2. A per-case access token (UnderdeclarationCase.caseAccessToken) issued
//      when a demand notice is created, scoping each request to one case so the
//      partner can never enumerate arbitrary taxpayers.

model IntegrationApiKey {
  id         String    @id @default(uuid())
  name       String    // partner platform label, e.g. "FCT-IRS Taxpayer Portal"
  keyHash    String    @unique // SHA-256 of the raw key; raw shown once at creation
  keyPrefix  String    // first 8 chars, for identification in the UI
  scopes     String[]  @default(["TAXPAYER_NOTICES"])
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdById String?
  createdAt  DateTime  @default(now())

  @@index([isActive])
  @@map("integration_api_keys")
}

// ─── PER-SECTOR THRESHOLD OVERRIDES ───────────────────────────────────────────
// The analyst feedback loop tunes the flagging threshold per economic sector.
// An override is only stored after the fairness gate passes (or is force-applied
// with an explicit override, which is recorded). The scan reads these per sector.

model SectorThreshold {
  id             String   @id @default(uuid())
  sector         String   @unique
  threshold      Decimal  @db.Decimal(5, 4)
  fairnessPassed Boolean  @default(true)
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("sector_thresholds")
}

// ─── CROSS-STATE DATA SHARING (Joint Revenue Board Act 2025 §15) ──────────────
// Captures mobile/migratory taxpayers: FCT-IRS refers non-FCT-resident taxpayers
// to their home State IRS (and receives inbound referrals), sharing a minimised
// summary (TIN + amounts) — NOT raw BVN/account (NDPA purpose limitation).

enum ReferralDirection {
  OUTBOUND
  INBOUND
}

enum ReferralStatus {
  DRAFT
  SENT
  ACKNOWLEDGED
  RECEIVED
  CLOSED
}

model CrossStateReferral {
  id            String            @id @default(uuid())
  taxpayerId    String?
  direction     ReferralDirection
  fromAuthority String            // e.g. 'FCT-IRS'
  toAuthority   String            // e.g. 'Lagos State IRS'
  state         String            // taxpayer's residential / transacting state
  basis         String            @default("JRBA 2025 s.15")
  year          Int?
  payload       Json?             // minimised summary shared with the other authority
  status        ReferralStatus    @default(DRAFT)
  createdById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  taxpayer Taxpayer? @relation(fields: [taxpayerId], references: [id])

  @@index([direction, status])
  @@map("cross_state_referrals")
}

// ─── NOTIFICATIONS / ALERTS ───────────────────────────────────────────────────

model Notification {
  id         String   @id @default(uuid())
  type       String   // 'HIGH_VALUE_FLAG' | 'MISSED_SUBMISSION' | 'OBJECTION_DEADLINE' | 'OVERDUE_RESPONSE'
  severity   String   @default("INFO") // 'INFO' | 'WARNING' | 'CRITICAL'
  title      String
  message    String
  entity     String?
  entityId   String?
  targetRole String?  // null = all staff
  targetUserId String? // when set, this notification is for one specific staff member
  targetProviderId String? // when set, this notification is for a data provider (portal)
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([read, createdAt])
  @@index([targetUserId, read])
  @@index([targetProviderId, read])
  @@map("notifications")
}

// ─── BANK MoU / ONBOARDING (§7) ───────────────────────────────────────────────

enum MouStatus {
  DRAFT
  SENT
  EXECUTED
  TERMINATED
}

model BankMou {
  id           String    @id @default(uuid())
  providerId   String    @unique
  status       MouStatus @default(DRAFT)
  channel      String?   // 'SFTP' | 'REST' | 'BACKUP'
  contactName  String?
  contactEmail String?
  signedAt     DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  provider DataProvider @relation(fields: [providerId], references: [id])

  @@map("bank_mous")
}

// ─── AI ANALYTICS AGENT SIGNALS ───────────────────────────────────────────────
// Each of the six analytics agents writes a per-taxpayer-per-year RiskSignal.
// These feed the officer review queue and the taxpayer risk score.

model RiskSignal {
  id          String   @id @default(uuid())
  taxpayerId  String
  year        Int
  agentKey    String   // 'pattern' | 'matching' | 'sector' | 'behavioural' | 'predictive' | 'document'
  score       Decimal  @db.Decimal(3, 2) // 0..1
  severity    String   // 'LOW' | 'MEDIUM' | 'HIGH'
  summary     String
  details     Json?
  createdAt   DateTime @default(now())

  taxpayer Taxpayer @relation(fields: [taxpayerId], references: [id])

  @@unique([taxpayerId, year, agentKey])
  @@index([agentKey, year])
  @@map("risk_signals")
}

// ─── JUST-IN-TIME ACCESS ELEVATION ───────────────────────────────────────────
// A time-boxed, supervisor-approved grant to view sensitive PII (BVN / full
// account number). Realises the §5.3 "JIT elevation" control.

enum ElevationStatus {
  PENDING   // awaiting supervisor approval
  ACTIVE    // approved and within its 30-minute window
  DENIED    // supervisor refused
  EXPIRED   // window elapsed / revoked
}

model AccessElevation {
  id          String          @id @default(uuid())
  staffId     String
  scope       String          @default("PII") // what the grant unlocks
  reason      String          // business justification (audited)
  status      ElevationStatus @default(PENDING)
  requestedAt DateTime        @default(now())
  decidedById String?
  decidedAt   DateTime?
  expiresAt   DateTime?       // set on approval (requestedAt/approval + 30 min)

  staff     User  @relation("ElevationStaff", fields: [staffId], references: [id])
  decidedBy User? @relation("ElevationDecider", fields: [decidedById], references: [id])

  @@index([staffId, status])
  @@map("access_elevations")
}

// ─── AUDIT LOG ───────────────────────────────────────────────────────────────

model AuditLog {
  id              String   @id @default(uuid())
  actorType       String   // 'STAFF' | 'PROVIDER_USER' | 'SYSTEM'
  actorId         String?
  staffId         String?  // populated when actorType=STAFF
  action          String   // e.g. 'CREATE_RECORD', 'REVIEW_REPORT', 'LOGIN', 'UPDATE_TAXPAYER'
  entity          String   // e.g. 'DataRecord', 'Taxpayer', 'DataProvider'
  entityId        String?
  beforeJson      Json?
  afterJson       Json?
  ip              String?
  userAgent       String?
  hashChainPrev   String?  // prev record's hash (tamper evidence)
  hashChainCurr   String?  // sha256(prev + this record)
  createdAt       DateTime @default(now())

  staff User? @relation("AuditUser", fields: [staffId], references: [id])

  @@index([entity, entityId])
  @@index([actorType, actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── PROVIDER SCHEMA TEMPLATES (defines expected CSV columns per provider type) ──

model ProviderSchema {
  id              String       @id @default(uuid())
  providerType    ProviderType @unique
  name            String
  description     String?
  columns         Json         // array of { name, type, required, validation }
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("provider_schemas")
}

// ─── IRIS — AGENTIC AI ASSISTANT ──────────────────────────────────────────────
// IRIS (Intelligent Revenue Insight System) is the conversational agent. It
// orchestrates existing services through permission-gated tools; sensitive
// actions are proposed as drafts a human confirms. Nothing here bypasses the
// detection engine, the PII access policy, or the audit chain. Status/kind are
// free-text (matching the codebase convention) to avoid enum migrations.

model IrisConversation {
  id        String        @id @default(uuid())
  staffId   String
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  IrisMessage[]

  @@index([staffId, updatedAt])
  @@map("iris_conversations")
}

model IrisMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String // 'user' | 'assistant'
  text           String?  @db.Text // human-readable rendering
  blocks         Json? // raw Anthropic content blocks, for replay
  createdAt      DateTime @default(now())

  conversation IrisConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("iris_messages")
}

model IrisDraft {
  id             String    @id @default(uuid())
  staffId        String
  conversationId String?
  kind           String // 'report' | 'scan' | 'notice'
  status         String    @default("PENDING") // PENDING | CONFIRMED | CANCELLED | EXPIRED
  summary        String    @db.Text
  payload        Json // the intended action's parameters
  resultRef      String? // id of the produced artifact/entity on confirm
  createdAt      DateTime  @default(now())
  decidedAt      DateTime?

  @@index([staffId, status])
  @@map("iris_drafts")
}

model IrisExport {
  id           String    @id @default(uuid())
  staffId      String
  draftId      String?
  fileName     String
  format       String // 'pdf' | 'xlsx' | 'csv'
  mimeType     String
  sizeBytes    Int       @default(0)
  cipher       String    @db.Text // AES-256-GCM(base64(file)) via CryptoService
  createdAt    DateTime  @default(now())
  downloadedAt DateTime?

  @@index([staffId, createdAt])
  @@map("iris_exports")
}

model IrisUsage {
  id             String   @id @default(uuid())
  staffId        String?
  conversationId String?
  feature        String // 'chat' | 'report' | 'scan' | 'notice'
  model          String
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  costUsdMicros  Int      @default(0) // COGS in micro-USD (integer, no float)
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@map("iris_usage")
}
