# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build output
dist/
.next/
build/
out/

# TypeScript build info
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local
!.env.example

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Prisma
prisma/*.db
prisma/*.db-journal

# Coverage
coverage/
*.lcov

# Logs
logs/
*.log

# Uploads (runtime file storage)
uploads/

# Standalone erev restore artifacts (separate app + MySQL data dir — not part of BIZDATA)
erev_app/
erev_instance/

# Local Claude Code agent config / scratch
.claude/

# ── Non-code artifacts (docs, exports, data dumps, media) ────────────────────
# Generated/authored documents — kept on disk, not in version control.
*.docx
*.doc
*.pdf
*.pptx
*.ppt
*.xlsx
*.xls
# Office temp lock files
~$*

# Database dumps / backups (schema migrations under prisma/migrations are code
# and are NOT matched by these).
*.sql.gz
*.dump
*.bak
erev_backup_*.sql
*-backup*.sql
*_backup*.sql

# Archives
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Loose data / media dropped at the repo root (app assets live under */public
# or */assets and are committed there; this only catches stray files).
/*.csv
/*.tsv
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.mp4
/*.mov

# Local scratch notes (may contain secrets — never commit)
/note.md
